# Copy to .env.local (git-ignored) and fill in the keys you use.

# Cloud ASR (Gladia v2 pre-recorded transcription)
GLADIA_API_KEY=
# Optional Gladia upload tuning (opus 48kbps default; set flac for lossless upload)
# GLADIA_UPLOAD_FORMAT=opus
# GLADIA_OPUS_BITRATE=48k

# Local workspace paths (optional; defaults to sibling ../ellara repo)
# ELLARA_ROOT=/path/to/ellara

# Agent CLI default model overrides (optional; sensible defaults are built in)
# AGY_MODEL=gemini-4-neon-medium
# CODEX_MODEL=gpt-5.4
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-2.5-pro

# Optional D&D Beyond game-log dice integration (CobaltSession cookie + numeric campaign ID)
# DDB_COBALT_SESSION=
# DDB_CAMPAIGN_ID=
# DDB_USER_ID=

# Optional direct Gemini Developer API key (only needed if using direct google-genai API)
# GEMINI_API_KEY=
